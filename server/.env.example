# NovaFleet API configuration
PORT=4000

# CORS: comma-separated list of allowed web origins (the Vite app).
CORS_ORIGIN=http://localhost:5173

# Supabase project URL, e.g. https://your-project.supabase.co
SUPABASE_URL=

# Service-role key (server-side only, NEVER expose to the browser).
# The API uses this to read/write fleet data and bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# The database schema that holds fleet tables.
SUPABASE_SCHEMA=fleet

# Telemetry ingestion (ESP32 devices + mobile offline-sync). Devices send this
# key in the X-API-Key header. Generate a strong random value; keep it secret.
INGEST_API_KEY=
# Acceleration spike that raises an incident alert.
INGEST_ACCEL_THRESHOLD=3.0
# Max ingestion requests per device per minute.
INGEST_RATE_LIMIT_PER_MIN=120
