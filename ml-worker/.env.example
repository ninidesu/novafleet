# NovaFleet ML Worker configuration (server-side secrets — never commit .env)

# Same Supabase project as the API. The worker uses the service-role key to
# read telemetry and write risk_scores / route_anomalies (bypasses RLS).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNvZWx3ZGN1a2pnYmlrYnpkdmVhIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4MzMwODA3OSwiZXhwIjoyMDk4ODg0MDc5fQ._LFKxpCGFoVnwWqjnS8wDS-MBde2RpF8EoTs0QUMt10
SUPABASE_SCHEMA=fleet

# Route anomaly: flag when max deviation from the planned route exceeds this (m).
ROUTE_DEVIATION_THRESHOLD_M=150

# Risk: flag a trip when total_risk_score is at or above this (0-100).
RISK_FLAG_THRESHOLD=60

# Minimum sensor readings a trip needs before it is scored.
MIN_READINGS=3

# Loop mode: seconds between passes.
POLL_INTERVAL_SECONDS=60
