# Supabase — used for Auth (login/session) only. Data goes through the API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# NovaFleet REST API base URL.
# Leave unset in local dev to use the Vite proxy at /api (see vite.config.js).
# In production set this to the deployed API origin, e.g.
# VITE_API_URL=https://novafleet-api.onrender.com/api
VITE_API_URL=
