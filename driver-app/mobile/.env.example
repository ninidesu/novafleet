# NovaFleet Driver App configuration (Expo public env — safe for the client).
# Copy to .env and fill in. In Expo, only EXPO_PUBLIC_* vars are exposed.

# Base URL of the NovaFleet API.
# IMPORTANT: on a physical phone / emulator, "localhost" points at the phone,
# not your computer. Use your dev machine's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://192.168.100.203:4000

# Supabase — used for driver login only (same project as the web app).
# Use the publishable/anon key (public, safe for the client).
EXPO_PUBLIC_SUPABASE_URL=https://coelwdcukjgbikbzdvea.supabase.co
