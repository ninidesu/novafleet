# Root env for docker-compose (web build args only). Copy to .env.
# The API and worker read their own server/.env and ml-worker/.env files.

# What the web app calls for the API. For the compose stack, point at the API
# service via your host (the browser runs outside the compose network):
VITE_API_URL=http://localhost:4000/api

# Supabase (publishable/anon key — safe for the browser).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
